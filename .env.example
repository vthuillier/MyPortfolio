# Application Configuration
APP_NAME=MyPortfolio
APP_ENV=production
APP_DEBUG=false

# Database Configuration
# Options: pgsql, mysql, sqlite
DB_CONNECTION=sqlite

# For SQLite
DB_FILE=database/portfolio.sqlite

# For PostgreSQL / MariaDB
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=portfolio_db
DB_USERNAME=portfolio_admin
DB_PASSWORD=portfolio_secure_pass

# Mail Configuration (Example)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
